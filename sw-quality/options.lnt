-rw(*ms) // Disable microsoft keywords huge, far, near etc
-estring(9051,__asm__) // co-gcc.lnt defines various __asm__ spellings which makes misra complain
-e830 // Disable additonal location hints for various error messages to reduce logspam

// Output format
// -------------
// Vim Quickfix format
//-"format= %f%(:%l%)%(:%c:%) %t %n: %m\n\n"

// Single line format
-width(0)   // don't insert line breaks (unlimited output width).
-"format= %t %n$ %f%($%l%)%($%c$%) %m"
-h1

// Supress false possitives of rule 1.3 regarding potential undefined behavior
// because of potential side effects on both sides of operator
-sem(fabsf, pure)
-sem(fabs, pure)
-sem(__issignaling, pure)
-sem(__fpclassifyf, pure)
-sem(__fpclassifyd, pure)
-sem(cos, pure)
-sem(sin, pure)
-sem(expf, pure)
-sem(log1pf, pure)
-sem(sqrtf, pure)
-sem(exp, pure)
-sem(j0, pure)
-sem(log, pure)
-sem(j1, pure)
-sem(cosf, pure)
-sem(coshf, pure)
-sem(clogf, pure)
-sem(csqrtf, pure)
-sem(sinhf, pure)
-sem(sinf, pure)
-sem(cosh, pure)
-sem(clog, pure)
-sem(csqrt, pure)
-sem(creal, pure)
-sem(cimag, pure)
