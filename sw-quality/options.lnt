-rw(*ms) // Disable microsoft keywords huge, far, near etc
-estring(9051,__asm__) // co-gcc.lnt defines various __asm__ spellings which makes misra complain
-e830 // Disable additonal location hints for various error messages to reduce logspam

// Output format
// -------------
// Vim Quickfix format
//-"format= %f%(:%l%)%(:%c:%) %t %n: %m\n\n"

// Single line format
-width(0)   // don't insert line breaks (unlimited output width).
-"format= %t %n$ %f%($%l%)%($%c$%) %m"
-h1

// Supress false possitives of rule 2.1 regarding potential unreachable code
// because of constant value boolean
-emacro(506, GET_HIGH_WORD)
-emacro(506, GET_LOW_WORD)
-emacro(506, SET_HIGH_WORD)
-emacro(506, SET_LOW_WORD)
-emacro(506, INSERT_WORDS)
-emacro(506, EXTRACT_WORDS)
-emacro(506, GET_FLOAT_WORD)
-emacro(506, SET_FLOAT_WORD)
-emacro(506, isnan)
-emacro(506, signbit)
-emacro(506, isinf)
